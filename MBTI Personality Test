# --------------------------------------------------
# Get user's answer
# --------------------------------------------------

def get_answer():
    while True:
        answer = input("Your answer (Y/N): ").strip().lower()

        if answer in ("y", "yes"):
            return "yes"

        if answer in ("n", "no"):
            return "no"

        print("Please enter Y or N.")


# --------------------------------------------------
# Calculate personality type
# --------------------------------------------------

def calculate_personality(answers):
    scores = {
        "E": 0,
        "I": 0,
        "S": 0,
        "N": 0,
        "T": 0,
        "F": 0,
        "J": 0,
        "P": 0
    }

    for answer, first_type, second_type in answers:

        if answer == "yes":
            scores[first_type] += 1
        else:
            scores[second_type] += 1

    personality = ""

    personality += "E" if scores["E"] >= scores["I"] else "I"
    personality += "S" if scores["S"] >= scores["N"] else "N"
    personality += "T" if scores["T"] >= scores["F"] else "F"
    personality += "J" if scores["J"] >= scores["P"] else "P"

    return personality, scores


# --------------------------------------------------
# Calculate percentages
# --------------------------------------------------

def calculate_percentages(scores):
    percentages = {}

    pairs = [
        ("E", "I"),
        ("S", "N"),
        ("T", "F"),
        ("J", "P")
    ]

    for first, second in pairs:

        total = scores[first] + scores[second]

        first_percentage = round((scores[first] / total) * 100)
        second_percentage = 100 - first_percentage

        percentages[first] = first_percentage
        percentages[second] = second_percentage

    return percentages


